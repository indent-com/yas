{
  "name": "yas-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run sync && astro dev",
    "build": "pnpm run sync && astro build",
    "preview": "astro preview",
    "typecheck": "pnpm run sync && astro check",
    "lint:docs": "nimbus-docs lint",
