    "@iconify-json/ph": "^1.2.0",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.0",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "26.2.0",
    "pagefind": "^1.5.2",
