---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title: string;
  /** Iconify icon name, e.g. `ph:lightning`. */
  icon?: string;
  /** When set, the whole card becomes a link to this URL. */
  href?: string;
}

const { title, icon, href, class: className, ...attrs } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag
  href={href}
  class={cn(
    "my-4 block rounded-lg bg-card p-5 shadow-sm ring ring-border",
    href &&
      "no-underline transition-colors hover:ring-foreground/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50",
    className,
  )}
  {...attrs}
>
  {icon && <Icon name={icon} class="mb-2.5 block w-6 h-6 text-foreground" />}
  <h3 class="m-0 text-base font-semibold leading-snug text-foreground">{title}</h3>
  <div class="mt-1.5 text-sm leading-normal text-muted-foreground">
    <slot />
  </div>
</Tag>

