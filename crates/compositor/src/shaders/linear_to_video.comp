#version 450
// Linear BT.2020 (1 = 203 nits) to limited-range P3/sRGB/PQ video.
layout(local_size_x=16, local_size_y=16) in;
layout(set=0,binding=0,rgba16f) readonly uniform image2D source;
#if defined(PLANAR_8)
layout(set=0,binding=1,r8) writeonly uniform image2D plane_y;
layout(set=0,binding=2,r8) writeonly uniform image2D plane_u;
layout(set=0,binding=3,r8) writeonly uniform image2D plane_v;
#elif defined(PLANAR_16)
layout(set=0,binding=1,r16) writeonly uniform image2D plane_y;
layout(set=0,binding=2,r16) writeonly uniform image2D plane_u;
layout(set=0,binding=3,r16) writeonly uniform image2D plane_v;
#elif defined(PACKED_8)
layout(set=0,binding=1,rgba8) writeonly uniform image2D packed_output;
#elif defined(PACKED_10)
layout(set=0,binding=1,rgb10_a2) writeonly uniform image2D packed_output;
#elif defined(PACKED_16)
layout(set=0,binding=1,rgba16) writeonly uniform image2D packed_output;
#elif defined(BUFFER_OUTPUT)
layout(set=0,binding=1,std430) buffer Output { uint words[]; };
#elif defined(TEN_BIT)
layout(set=0,binding=1,r16) writeonly uniform image2D luma;
layout(set=0,binding=2,rg16) writeonly uniform image2D chroma;
#else
layout(set=0,binding=1,r8) writeonly uniform image2D luma;
layout(set=0,binding=2,rg8) writeonly uniform image2D chroma;
#endif
layout(push_constant) uniform Params {
    uint sw; uint sh; uint width; uint height;
    uint output_color; uint hdr; uint full_chroma; uint visible_size;
#ifdef BUFFER_OUTPUT
    uint stride; uint uv_offset;
#endif
};
vec3 fetch(ivec2 p) { return imageLoad(source,clamp(p,ivec2(0),ivec2(sw,sh)-1)).rgb; }
vec3 linear_pixel(ivec2 p) {
    uvec2 visible=uvec2(visible_size&65535u,visible_size>>16u);
    if(any(equal(visible,uvec2(0)))) visible=uvec2(width,height);
    p=clamp(p,ivec2(0),ivec2(visible)-1);
    vec2 uv=(vec2(p)+0.5)*vec2(sw,sh)/vec2(visible)-0.5;
    ivec2 base=ivec2(floor(uv)); vec2 f=fract(uv);
    return mix(mix(fetch(base),fetch(base+ivec2(1,0)),f.x),
               mix(fetch(base+ivec2(0,1)),fetch(base+ivec2(1,1)),f.x),f.y);
}
vec3 rgb(ivec2 p) {
    vec3 c=linear_pixel(p);
    if(output_color==2u) {
        vec3 v=pow(clamp(c*203.0/10000.0,0.0,1.0),vec3(2610.0/16384.0));
        return pow((vec3(3424.0/4096.0)+(2413.0/128.0)*v)/(vec3(1)+(2392.0/128.0)*v),vec3(2523.0/32.0));
    }
    float y=max(dot(c,vec3(0.2627,0.678,0.0593)),0.0);
    if(hdr!=0u && y>0.75) {
        float mapped=0.75+0.25*(1.0-exp(-(y-0.75)/0.25));
        if(hdr>1u) {
            float range=uintBitsToFloat(hdr)/203.0-0.75;
            float x=min(y-0.75,range);
            mapped=0.75+x/(1.0+x*(4.0-1.0/range));
        }
        c*=mapped/y;
    }
    if(output_color==1u) {
        c=vec3(dot(c,vec3(1.343578,-0.282180,-0.061399)),dot(c,vec3(-0.065298,1.075788,-0.010490)),dot(c,vec3(0.002822,-0.019599,1.016777)));
        y=clamp(dot(c,vec3(0.228975,0.691739,0.079287)),0.0,1.0);
    } else {
        c=vec3(dot(c,vec3(1.660491,-0.587641,-0.072850)),dot(c,vec3(-0.124550,1.1329,-0.008349)),dot(c,vec3(-0.018151,-0.100579,1.11873)));
        y=clamp(dot(c,vec3(0.2126,0.7152,0.0722)),0.0,1.0);
    }
    float sat=1.0;
    for(int i=0;i<3;i++) { if(c[i]<0.0) sat=min(sat,y/(y-c[i])); if(c[i]>1.0) sat=min(sat,(1.0-y)/(c[i]-y)); }
    c=clamp(vec3(y)+(c-vec3(y))*sat,0.0,1.0);
    return mix(1.055*pow(c,vec3(1.0/2.4))-vec3(0.055),12.92*c,lessThanEqual(c,vec3(0.0031308)));
}
vec3 yuv(ivec2 p) {
    vec3 c=rgb(p);
    vec2 k=output_color==2u ? vec2(0.2627,0.0593) : (output_color==1u ? vec2(0.2126,0.0722) : vec2(0.299,0.114));
    float y=dot(c,vec3(k.x,1.0-k.x-k.y,k.y));
    return vec3(y,(c.b-y)/(2.0*(1.0-k.y)),(c.r-y)/(2.0*(1.0-k.x)));
}
#ifdef BUFFER_OUTPUT
void store_sample(uint offset, uint value) {
    atomicOr(words[offset/4u], value << ((offset%4u)*8u));
}
#endif
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(p.x>=width || p.y>=height) return;
    vec3 v=yuv(p);
#if defined(PLANAR_8) || defined(PLANAR_16)
#ifdef PLANAR_8
    vec3 q=round(vec3(16,128,128)+vec3(219,224,224)*v)/255.0;
#else
    vec3 q=round(vec3(64,512,512)+vec3(876,896,896)*v)*64.0/65535.0;
#endif
    imageStore(plane_y,p,vec4(q.x,0,0,0));
    imageStore(plane_u,p,vec4(q.y,0,0,0));
    imageStore(plane_v,p,vec4(q.z,0,0,0));
#elif defined(PACKED_8)
    // Little-endian AYUV stores V,U,Y,A bytes in both DRM and VAImage.
    vec3 q=round(vec3(16,128,128)+vec3(219,224,224)*v)/255.0;
    imageStore(packed_output,p,vec4(q.z,q.y,q.x,1));
#elif defined(PACKED_10) || defined(PACKED_16)
    vec3 q=round(vec3(64,512,512)+vec3(876,896,896)*v);
#ifdef PACKED_10
    q/=1023.0;
#else
    q*=64.0/65535.0;
#endif
    // DRM Y410/Y416 store U,Y,V,A components.
    imageStore(packed_output,p,vec4(q.y,q.x,q.z,1));
#else
#ifdef TEN_BIT
    float y=round(64.0+876.0*v.x)*64.0/65535.0;
#else
    float y=round(16.0+219.0*v.x)/255.0;
#endif
#ifdef BUFFER_OUTPUT
#ifdef TEN_BIT
    const uint bytes=2u;
    store_sample(uint(p.y)*stride+uint(p.x)*bytes,uint(round(y*65535.0)));
#else
    const uint bytes=1u;
    store_sample(uint(p.y)*stride+uint(p.x),uint(round(y*255.0)));
#endif
#else
    imageStore(luma,p,vec4(y,0,0,0));
#endif
    if(full_chroma!=0u || ((p.x&1)==0 && (p.y&1)==0)) {
        vec2 uv=v.yz;
        if(full_chroma==0u) uv=(uv+yuv(p+ivec2(1,0)).yz+yuv(p+ivec2(0,1)).yz+yuv(p+ivec2(1,1)).yz)/4.0;
#ifdef TEN_BIT
        uv=round(vec2(512.0)+896.0*uv)*64.0/65535.0;
#else
        uv=round(vec2(128.0)+224.0*uv)/255.0;
#endif
#ifdef BUFFER_OUTPUT
#ifdef TEN_BIT
        uvec2 q=uvec2(round(uv*65535.0));
#else
        uvec2 q=uvec2(round(uv*255.0));
#endif
        if(full_chroma!=0u) {
            uint offset=uv_offset+uint(p.y)*stride+uint(p.x)*bytes;
            store_sample(offset,q.x);
            store_sample(offset+stride*height,q.y);
        } else {
            uint offset=uv_offset+uint(p.y/2)*stride+uint(p.x)*bytes;
            store_sample(offset,q.x);
            store_sample(offset+bytes,q.y);
        }
#else
        imageStore(chroma,full_chroma!=0u ? p : p/2,vec4(uv,0,0));
#endif
    }
#endif
}
