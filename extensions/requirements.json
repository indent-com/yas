{
  "doctor": {
    "version": 1,
    "runtime": "quickjs",
    "commandProvider": true,
    "families": [
      {
        "name": "channel",
        "version": 1,
        "operations": ["LISTEN"],
        "events": ["ACCEPT"]
      }
    ],
    "probes": []
  },
  "muster": {
    "version": 1,
    "runtime": "wasmi",
    "commandProvider": true,
    "families": [
      {
        "name": "terminal",
        "version": 1,
        "operations": ["CREATE", "WATCH", "CLOSE"]
      },
      {
        "name": "fs",
        "version": 1,
        "operations": ["OPEN", "INDEX", "READ", "WATCH"]
      },
      { "name": "env", "version": 1, "operations": ["GET"] },
      {
        "name": "kv",
        "version": 1,
        "operations": ["OPEN", "GET", "PUT", "WATCH"]
      },
      {
        "name": "channel",
        "version": 1,
        "operations": ["LISTEN"],
        "events": ["ACCEPT"]
      }
    ],
    "probes": ["muster-config"],
    "activation": "Starts existing configured units."
  },
  "systemd": {
    "version": 1,
    "runtime": "wasmi",
    "commandProvider": true,
    "platforms": ["linux"],
    "families": [
      {
        "name": "process",
        "version": 1,
        "operations": ["SPAWN", "CONTROL", "WAIT"]
      },
      {
        "name": "channel",
        "version": 1,
        "operations": ["LISTEN"],
        "events": ["ACCEPT"]
      }
    ],
    "probes": ["systemd"]
  },
  "xdg-desktop": {
    "version": 1,
    "runtime": "wasmi",
    "commandProvider": true,
    "platforms": ["linux"],
    "families": [
      {
        "name": "surface",
        "version": 1,
        "operations": ["CREATE_APP_ENDPOINT", "WATCH"]
      },
      {
        "name": "process",
        "version": 1,
        "operations": ["SPAWN", "CONTROL", "WAIT"]
      },
      {
        "name": "fs",
        "version": 1,
        "operations": ["OPEN", "INDEX", "READ", "WATCH"]
      },
      { "name": "env", "version": 1, "operations": ["GET"] },
      {
        "name": "kv",
        "version": 1,
        "operations": ["OPEN", "GET", "PUT", "WATCH"]
      },
      {
        "name": "channel",
        "version": 1,
        "operations": ["LISTEN"],
        "events": ["ACCEPT"]
      }
    ],
    "probes": ["xdg-applications"]
  }
}
